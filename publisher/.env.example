# Copy to .env (git-ignored) and fill in. Never commit real values.
# YouTube: OAuth client (Desktop app) + refresh token with scope youtube.upload
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Facebook Page: numeric Page ID + long-lived Page access token (pages_manage_posts, pages_read_engagement)
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Instagram: Business/Creator account linked to the Page; IG user id + token with instagram_content_publish
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_VERSION=v21.0
